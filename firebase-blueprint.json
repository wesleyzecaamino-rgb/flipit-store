{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated shopper profile stored privately under users/{userId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "emailSeasonalDrops": {
          "type": "boolean",
          "description": "Whether the member opted in to email notifications for new seasonal drops."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Saved shopping bag line item under users/{userId}/cart/{itemId}.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["MEN", "WOMEN", "SEASONAL", "ACCESSORIES"],
          "maxLength": 32
        },
        "colorway": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "size": {
          "type": "string",
          "enum": ["XS", "S", "M", "L", "XL", "OS"],
          "maxLength": 8
        },
        "priceCents": {
          "type": "integer"
        },
        "quantity": {
          "type": "integer"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "itemId",
        "productId",
        "title",
        "category",
        "colorway",
        "size",
        "priceCents",
        "quantity",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved wishlist product under users/{userId}/wishlist/{productId}.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "priceCents": {
          "type": "integer"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productId", "title", "priceCents", "ownerId", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Confirmed customer order stored in /orders/{orderId}.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "shippingAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "enum": ["processing", "shipped", "delivered", "confirmed", "preparing"],
          "maxLength": 24
        },
        "totalCents": {
          "type": "integer"
        },
        "itemsCount": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "userId",
        "customerName",
        "customerEmail",
        "shippingAddress",
        "status",
        "totalCents",
        "itemsCount",
        "items",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private shopper profile document owned by userId."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Persistent shopping bag line items belonging to userId."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Saved wishlist products belonging to userId."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Immutable customer order receipts scoped by userId."
    }
  }
}
